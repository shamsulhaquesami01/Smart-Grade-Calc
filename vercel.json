{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash build_files.sh",
  "builds": [
    {
      "src": "smart_grade_calc/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "tracker/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/tracker/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "smart_grade_calc/wsgi.py"
    }
  ]
}
